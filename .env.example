# Neon Postgres (pooled connection string from Vercel Marketplace / Neon console)
DATABASE_URL=

# Required in production/Vercel: random 32+ byte secret for signing JWT cookies
JWT_SECRET=

# Vercel Blob token for property & room image uploads
BLOB_READ_WRITE_TOKEN=

# Optional: Resend API key for transactional emails (app skips email if unset)
RESEND_API_KEY=
EMAIL_FROM=CasaBatangueno <noreply@casa-bat.com>

# Required to protect /api/cron/daily on Vercel Cron
CRON_SECRET=

# Comma-separated allowed CORS origins for production (optional; same-origin allowed)
ALLOWED_ORIGINS=

# Set to production on Vercel production deployment
NODE_ENV=development