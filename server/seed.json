  "reviews": [
    { "id": 1, "propertyId": 1, "reviewerName": "Marco Santos", "email": "marco.santos@example.edu", "rating": 5, "title": "Bright balcony units and reliable fiber internet", "comment": "Living along Neptune St. has been super convenient—Alfamart is literally a minute away and the backup generator kept my online classes running during brownouts.", "status": "Approved", "ownerReply": "Thank you, Marco! Glad the balcony units and backup power are working well for your studies.", "repliedAt": "2026-10-12T10:30:00+08:00", "createdAt": "2026-10-10T14:20:00+08:00" },
    { "id": 2, "propertyId": 2, "reviewerName": "Camille Navarro", "email": "camille.n@example.edu", "rating": 5, "title": "Walkable to BatStateU and very quiet study lounge", "comment": "I can walk to Alfamart and BatStateU Alangilan in just a few minutes. The 2nd-floor study lounge and individual lockers make dorm life organized and stress-free.", "status": "Approved", "ownerReply": null, "repliedAt": null, "createdAt": "2026-10-22T09:15:00+08:00" },
    { "id": 3, "propertyId": 3, "reviewerName": "Bea Alcantara", "email": "bea.alcantara@example.com", "rating": 4, "title": "Clean furnished studio near the highway", "comment": "The oak workspace and ensuite bathroom are spotless, and catching a jeepney along Jose P. Laurel Highway is effortless. Great option if you work remotely.", "status": "Approved", "ownerReply": "We appreciate the kind feedback, Bea! Thank you for keeping Studio S-301 in great shape.", "repliedAt": "2026-11-03T11:00:00+08:00", "createdAt": "2026-11-02T17:45:00+08:00" },
    { "id": 4, "propertyId": 4, "reviewerName": "Daniela Cruz", "email": "daniela.cruz@example.edu", "rating": 5, "title": "Homey atmosphere and budget-friendly rent", "comment": "The shared kitchen saves me so much on food expenses, and the caretaker is quick to help whenever we need anything fixed. Highly recommended for students on a budget.", "status": "Approved", "ownerReply": null, "repliedAt": null, "createdAt": "2026-11-08T13:10:00+08:00" },
    { "id": 5, "propertyId": 5, "reviewerName": "Rafael Soriano", "email": "rafael.soriano@example.edu", "rating": 4, "title": "Peaceful single room for board review", "comment": "Very quiet neighborhood in Sitio Ibaba with good natural light and strong AC. Easy tricycle ride straight to the highway whenever it rains.", "status": "Approved", "ownerReply": null, "repliedAt": null, "createdAt": "2026-11-15T16:05:00+08:00" },
    { "id": 6, "propertyId": 2, "reviewerName": "Joshua Lim", "email": "joshua.lim@example.edu", "rating": 4, "title": "Safe biometric gate and responsive staff", "comment": "Biometric entry and CCTV give my parents peace of mind. Wi-Fi speed is consistently fast even in the evenings when everyone is online.", "status": "Pending", "ownerReply": null, "repliedAt": null, "createdAt": "2026-11-20T08:40:00+08:00" }
  ],
