{
  "version": 2,
  "functions": {
    "api/index.js": {
      "includeFiles": "{database/**,server/seed.json}"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" }
  ],
  "crons": [
    {
      "path": "/api/cron/daily",
      "schedule": "0 0 * * *"
    }
  ]
}
